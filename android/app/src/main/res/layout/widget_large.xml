<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="true" android:importantForAccessibility="yes">
    <ImageView android:id="@+id/widget_art" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitCenter" android:src="@drawable/widget_ginger" android:importantForAccessibility="no" />
    <TextView android:id="@+id/widget_caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_margin="10dp"
        android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:background="@drawable/widget_caption"
        android:text="@string/t04" android:textSize="13sp" android:textStyle="bold" android:textColor="#413936"
        android:maxLines="1" android:ellipsize="end" android:importantForAccessibility="no" />
</FrameLayout>
